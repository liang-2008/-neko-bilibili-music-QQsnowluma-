# SnowLuma OneBot v11 正向 WebSocket 地址
SNOWLUMA_WS_URL=ws://127.0.0.1:3001/
# WebUI / onebot_<uin>.json 里的 access token，没有就留空
SNOWLUMA_ACCESS_TOKEN=

# 点歌指令前缀
JUKEBOX_COMMAND=点歌

# QQ 语音最大时长（秒）。60 秒最稳；确认协议端支持再调大。
JUKEBOX_MAX_SECONDS=60
# MP3 码率
JUKEBOX_VOICE_BITRATE=48k
# 单首音频下载上限（MB）
JUKEBOX_MAX_DOWNLOAD_MB=60
# 同群点歌冷却（秒）
JUKEBOX_RATE_LIMIT_SECONDS=5

# 只允许这些群号点歌，多个用逗号分隔；留空 = 全部群
JUKEBOX_GROUP_WHITELIST=

# 点歌时先发一句“正在找”的提示
JUKEBOX_SEND_PROGRESS=1

# 可选：B站 cookies 文件路径；留空 = 使用同目录 bilibili_cookies.txt
BILI_COOKIE_FILE=
# 可选：直接写一整行 Cookie，优先级高于文件
# BILI_COOKIE=SESSDATA=xxx; bili_jct=xxx; buvid3=xxx

# 可选：ffmpeg 路径；留空 = 自动找系统 ffmpeg / imageio-ffmpeg
FFMPEG_PATH=

LOG_LEVEL=INFO